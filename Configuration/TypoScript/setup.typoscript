
plugin.tx_sparkdms_pi1 {
    view {
        templateRootPaths.0 = EXT:spark_dms/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.templateRootPath}
        partialRootPaths.0 = EXT:spark_dms/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.partialRootPath}
        layoutRootPaths.0 = EXT:spark_dms/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_sparkdms_pi1.persistence.storagePid}
    }
    # Settings structure for FlexForm override
    # Defines expected hierarchy - FlexForm values will be merged here
    settings {
        view {
            viewType = Default
            frontEndFilter = 0
            detailPid =
            pagination {
                limit = 0
                itemsPerPage = 10
            }
        }
        filter {
            selectedDocuments =
            documentTypes =
            documentCategories =
            dateRange {
                dateFrom = 0
                dateTo = 0
            }
        }
    }
}




plugin.tx_sparkdms_pi2 {
    view {
        templateRootPaths.0 = EXT:spark_dms/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.templateRootPath}
        partialRootPaths.0 = EXT:spark_dms/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.partialRootPath}
        layoutRootPaths.0 = EXT:spark_dms/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_sparkdms_pi1.view.layoutRootPath}
        
        # Share Namespace to allow processing links from Pi1 correctly
        pluginNamespace = tx_sparkdms_pi1
    }
    persistence {
        storagePid = {$plugin.tx_sparkdms_pi1.persistence.storagePid}
    }
}

config.tx_extbase.persistence.classes {
    RootBa\SparkDms\Domain\Model\Document {
        tableName = tx_sparkdms_domain_model_document
    }
    RootBa\SparkDms\Domain\Model\DocumentVersion {
        tableName = tx_sparkdms_domain_model_documentversion
    }
    RootBa\SparkDms\Domain\Model\DocumentType {
        tableName = tx_sparkdms_domain_model_documenttype
    }
    RootBa\SparkDms\Domain\Model\DocumentCategory {
        tableName = tx_sparkdms_domain_model_documentcategory
    }
}


# CType: Document List
tt_content.sparkdms_list = USER
tt_content.sparkdms_list < plugin.tx_sparkdms_pi1
tt_content.sparkdms_list {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = SparkDms
    pluginName = Pi1
    vendorName = RootBa
}

# CType: Document Detail
tt_content.sparkdms_detail = USER
tt_content.sparkdms_detail < plugin.tx_sparkdms_pi2
tt_content.sparkdms_detail {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = SparkDms
    pluginName = Pi2
    vendorName = RootBa
}
