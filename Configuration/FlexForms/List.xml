<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>General Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <!-- VIEW TYPE -->
                    <viewType>
                        <TCEforms>
                            <label>View Type</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Standard List</numIndex>
                                        <numIndex index="1">default</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Card View</numIndex>
                                        <numIndex index="1">card</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </viewType>
                    
                    <!-- FILTER: Document Types -->
                    <settings.documentTypes>
                        <TCEforms>
                            <label>Filter by Document Types</label>
                            <config>
                                <type>select</type>
                                <renderType>selectMultipleSideBySide</renderType>
                                <foreign_table>tx_sparkdms_domain_model_document_type</foreign_table>
                                <minitems>0</minitems>
                                <maxitems>99</maxitems>
                            </config>
                        </TCEforms>
                    </settings.documentTypes>
                    
                    <!-- FILTER: Categories -->
                    <settings.categories>
                        <TCEforms>
                            <label>Filter by Document Categories</label>
                            <config>
                                <type>select</type>
                                <renderType>selectTree</renderType>
                                <foreign_table>tx_sparkdms_domain_model_document_category</foreign_table>
                                <treeConfig>
                                    <parentField>parent</parentField>
                                    <appearance>
                                        <showHeader>1</showHeader>
                                        <expandAll>1</expandAll>
                                    </appearance>
                                </treeConfig>
                                <minitems>0</minitems>
                                <maxitems>99</maxitems>
                            </config>
                        </TCEforms>
                    </settings.categories>
                    
                    <!-- LIMIT -->
                    <settings.limit>
                        <TCEforms>
                            <label>Max Items</label>
                            <config>
                                <type>input</type>
                                <eval>int</eval>
                                <default>10</default>
                            </config>
                        </TCEforms>
                    </settings.limit>

                    <!-- DATE RANGE (Optional Backend Filter) -->
                    <!-- Usually simpler to leave Date Range to Frontend, but can add "Starting Year" here if needed -->
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
