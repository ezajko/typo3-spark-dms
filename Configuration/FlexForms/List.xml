<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Settings</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <!-- VIEW TYPE -->
                    <settings.viewType>
                        <label>View Type</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items></items>
                        </config>
                    </settings.viewType>

                    <!-- LIMIT -->
                    <settings.limit>
                        <label>Max Items (total limit)</label>
                        <config>
                            <type>number</type>
                            <default>0</default>
                        </config>
                    </settings.limit>

                    <!-- ITEMS PER PAGE -->
                    <settings.itemsPerPage>
                        <label>Items Per Page (Pagination)</label>
                        <config>
                            <type>number</type>
                            <default>10</default>
                        </config>
                    </settings.itemsPerPage>

                    <!-- DETAIL PAGE -->
                    <settings.detailPid>
                        <label>Detail Page (for Show links)</label>
                        <config>
                            <type>group</type>
                            <allowed>pages</allowed>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.detailPid>

                    <!-- SELECTED DOCUMENTS (Manual Selection) -->
                    <settings.selectedDocuments>
                        <label>Select Specific Documents (overrides filters)</label>
                        <config>
                            <type>group</type>
                            <allowed>tx_sparkdms_domain_model_document</allowed>
                            <size>5</size>
                            <maxitems>99</maxitems>
                            <minitems>0</minitems>
                        </config>
                    </settings.selectedDocuments>
                    
                    <!-- FILTER: Document Types -->
                    <settings.documentTypes>
                        <label>Filter by Document Types</label>
                        <config>
                            <type>select</type>
                            <renderType>selectMultipleSideBySide</renderType>
                            <foreign_table>tx_sparkdms_domain_model_document_type</foreign_table>
                            <minitems>0</minitems>
                            <maxitems>99</maxitems>
                        </config>
                    </settings.documentTypes>
                    
                    <!-- FILTER: Categories -->
                    <settings.categories>
                        <label>Filter by Document Categories</label>
                        <config>
                            <type>select</type>
                            <renderType>selectTree</renderType>
                            <foreign_table>tx_sparkdms_domain_model_document_category</foreign_table>
                            <treeConfig>
                                <parentField>parent</parentField>
                                <appearance>
                                    <showHeader>1</showHeader>
                                    <expandAll>1</expandAll>
                                </appearance>
                            </treeConfig>
                            <minitems>0</minitems>
                            <maxitems>99</maxitems>
                        </config>
                    </settings.categories>

                    <!-- DATE RANGE FILTER: From -->
                    <settings.dateFrom>
                        <label>Date From</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <default>0</default>
                        </config>
                    </settings.dateFrom>

                    <!-- DATE RANGE FILTER: To -->
                    <settings.dateTo>
                        <label>Date To</label>
                        <config>
                            <type>datetime</type>
                            <format>date</format>
                            <default>0</default>
                        </config>
                    </settings.dateTo>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
